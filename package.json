{
  "name": "@soccer-marble/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Soccer marble games monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "build:watch": "nx watch --all -- nx run %NX_PROJECT_NAME%:build",
    "check:deps": "npm-check-updates && nx run-many -t check:deps",
    "clean": "nx run-many -t clean",
    "reg": "npm set registry http://npm.lumigame.com",
    "test": "nx run-many -t test",
    "test-coverage": "nx run-many -t test-coverage",
    "type-check": "nx run-many -t type-check",
    "update:deps": "npm-check-updates -u && nx run-many -t update:deps"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-env": "7.28.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.7.2",
    "babel-jest": "30.2.0",
    "cross-env": "10.1.0",
    "jest": "30.2.0",
    "jest-auto-stub": "1.0.8",
    "jest-junit": "16.0.0",
    "jest-sonar-reporter": "2.0.0",
    "npm-check-updates": "19.0.0",
    "nx": "21.8.0",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
