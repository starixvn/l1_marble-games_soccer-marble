{
  "name": "soccer-marble",
  "version": "1.0.0",
  "description": "Soccer event generation service with MongoDB",
  "repository": {
    "type": "git",
    "url": "git@git3.nexdev.net:l1/marble-games/soccer-marble.git"
  },
  "author": "",
  "license": "ISC",
  "main": "./build/app.js",
  "type": "module",
  "scripts": {
    "start": "node ./build/app.js",
    "dev": "cross-env NODE_ENV=development tsx watch ./src/app.ts",
    "reg": "npm set registry http://npm.lumigame.com",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --testPathPattern=tests/unit-tests/",
    "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "dependencies": {
    "agenda": "^5.0.0",
    "awilix": "^12.0.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "extensionless": "^1.9.9",
    "mongoose": "^8.12.1",
    "sc-common": "^1.8.1",
    "sc-core-rng": "^1.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/mongoose": "^5.11.96",
    "@types/sc-common": "^1.0.0",
    "jest": "^29.7.0",
    "jest-auto-stub": "^1.0.8",
    "jest-junit": "^16.0.0",
    "jest-micro-auto-stub": "^1.0.9",
    "jest-sonar-reporter": "^2.0.0",
    "ts-jest": "^29.3.2"
  }
}
