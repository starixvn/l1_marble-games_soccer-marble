{
  "name": "soccer-marble-monorepo",
  "version": "1.0.0",
  "description": "Soccer marble games monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "test": "npm run test --workspaces",
    "pretest-coverage": "npm run shared:build",
    "test-coverage": "npm run test-coverage --workspaces",
    "reg": "npm set registry http://npm.lumigame.com",
    "clean": "npm run clean --workspaces",
    "type-check": "npm run type-check --workspaces",
    "app:2000:build": "npm run build --workspace=@soccer-marble/2000",
    "app:2001:build": "npm run build --workspace=@soccer-marble/2001",
    "app:2002:build": "npm run build --workspace=@soccer-marble/2002",
    "app:2003:build": "npm run build --workspace=@soccer-marble/2003",
    "app:2004:build": "npm run build --workspace=@soccer-marble/2004",
    "app:2005:build": "npm run build --workspace=@soccer-marble/2005",
    "shared:soccer-marble:build": "npm run build --workspace=@soccer-marble/soccer-marble-base",
    "shared:soccer-marble-live:build": "npm run build --workspace=@soccer-marble/soccer-marble-live",
    "shared:utils:build": "npm run build --workspace=@soccer-marble/shared-utils",
    "shared:build": "npm run shared:utils:build && npm run shared:soccer-marble:build && npm run shared:soccer-marble-live:build",
    "update:deps": "npm update --workspaces"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-env": "7.28.3",
    "@types/node": "20.0.0",
    "@types/jest": "30.0.0",
    "cross-env": "10.0.0",
    "babel-jest": "29.7.0",
    "jest": "30.1.1",
    "jest-junit": "16.0.0",
    "jest-sonar-reporter": "2.0.0",
    "jest-auto-stub": "1.0.8",
    "ts-jest": "29.4.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@10.0.0"
}
