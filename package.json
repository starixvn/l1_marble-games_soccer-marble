{
  "name": "soccer-marble-monorepo",
  "version": "1.0.0",
  "description": "Soccer marble games monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "test": "npm run test --workspaces",
    "pretest-coverage": "npm run shared:build",
    "test-coverage": "npm run test-coverage --workspaces",
    "reg": "npm set registry http://npm.lumigame.com",
    "clean": "npm run clean --workspaces",
    "type-check": "npm run type-check --workspaces",
    "app:2004:dev": "npm run dev --workspace=@soccer-marble/2004",
    "app:2004:build": "npm run build --workspace=@soccer-marble/2004",
    "app:2004:start": "npm run start --workspace=@soccer-marble/2004",
    "app:2004:test": "npm run test --workspace=@soccer-marble/2004",
    "app:2001:build": "npm run build --workspace=@soccer-marble/2001",
    "app:2001:test": "npm run test --workspace=@soccer-marble/2001",
    "app:2001:start": "npm run start --workspace=@soccer-marble/2001",
    "app:2001:dev": "npm run dev --workspace=@soccer-marble/2001",
    "app:soccer-marble:build": "npm run build --workspace=@soccer-marble/soccer-marble-base",
    "app:soccer-marble:test": "npm run test --workspace=@soccer-marble/soccer-marble-base",
    "shared:types:build": "npm run build --workspace=@soccer-marble/shared-types",
    "shared:utils:build": "npm run build --workspace=@soccer-marble/shared-utils",
    "shared:build": "npm run shared:types:build && npm run shared:utils:build",
    "update:deps": "npm update --workspaces"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@10.0.0"
}
