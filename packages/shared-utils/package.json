{
  "name": "@soccer-marble/shared-utils",
  "version": "1.0.0",
  "description": "Shared utility functions for soccer marble applications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest --testPathPatterns=tests/unit-tests/",
    "test-coverage": "jest --collect-coverage --testPathPatterns=tests/unit-tests/",
    "type-check": "tsc --noEmit",
    "check:deps": "npm-check-updates",
    "update:deps": "npm-check-updates -u"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
