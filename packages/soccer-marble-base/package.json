{
  "name": "@soccer-marble/soccer-marble-base",
  "version": "1.0.0",
  "description": "Soccer marble base package",
  "repository": {
    "type": "git",
    "url": "git@git3.nexdev.net:l1/marble-games/soccer-marble.git"
  },
  "author": "",
  "license": "ISC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "reg": "npm set registry http://npm.lumigame.com",
    "build": "tsc",
    "test": "jest --testPathPatterns=tests/unit-tests/",
    "test-coverage": "jest --collect-coverage --testPathPatterns=tests/unit-tests/",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "check:deps": "npm-check-updates",
    "update:deps": "npm-check-updates -u"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "dependencies": {
    "@soccer-marble/shared-utils": "1.0.0",
    "agenda": "5.0.0",
    "awilix": "12.0.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "mongoose": "8.19.3",
    "sc-common": "3.0.0",
    "sc-core-rng": "1.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/sc-common": "1.0.2"
  }
}
